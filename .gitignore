# Local db files (if sqlite used for local dev/testing)
*.sqlite3
*.db

.vercel

# Local machine settings, not part of the template
.claude/settings.local.json

# Secrets again, last word wins over anything above.
# Keep the negation after the pattern or .env.example gets excluded too.
.env*
!.env.example
