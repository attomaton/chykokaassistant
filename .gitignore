# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.pytest_tmp/
.mypy_cache/
.ruff_cache/
htmlcov/
