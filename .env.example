# =============================================================================
# Telegram Business Assistant - Environment Variables
# Copy this file to .env for local development. Never commit the real .env.
# In Vercel: Project Settings -> Environment Variables -> add each key below
# for the "Production" (and optionally "Preview"/"Development") environments.
# =============================================================================

# --- Telegram ---------------------------------------------------------------
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Random long secret used to validate that webhook requests really come from
# Telegram (sent back via the X-Telegram-Bot-Api-Secret-Token header).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=

# --- OpenAI ------------------------------------------------------------------
OPENAI_API_KEY=
# Keep the model configurable. Verify the model name is currently available
# on your OpenAI account before deploying. gpt-5-mini is a reasonable,
# low-cost default for a support-assistant workload as of writing.
OPENAI_MODEL=gpt-5-mini

# --- Database ------------------------------------------------------------
# Async Postgres URL. Prefer a connection-pooling provider (Neon, Supabase,
# RDS Proxy) since serverless functions open many short-lived connections.
# Accepted forms: postgres://... , postgresql://... , postgresql+asyncpg://...
DATABASE_URL=

# --- Administrator bootstrap --------------------------------------------
# One-time secret used with /claim <secret> to register the first admin.
# Leave ADMIN_TELEGRAM_ID unset if you want to use the /claim flow.
ADMIN_SETUP_SECRET=

# Optional: if set, this Telegram numeric user ID is automatically installed
# as the administrator at startup and /claim is permanently disabled.
# Get your numeric ID from @userinfobot on Telegram.
ADMIN_TELEGRAM_ID=

# --- App -----------------------------------------------------------------
# Public base URL of the deployed app, no trailing slash.
APP_URL=https://your-project.vercel.app

# --- Tuning (safe defaults, all optional) ---------------------------------
AI_CONFIDENCE_THRESHOLD=0.75
MAX_KNOWLEDGE_CHARACTERS=80000
MAX_CONVERSATION_TURNS=10
CONVERSATION_TTL_MINUTES=180
MAX_MESSAGE_LENGTH=2000
RATE_LIMIT_MESSAGES_PER_MINUTE=15
OPENAI_TIMEOUT_SECONDS=20
TELEGRAM_TIMEOUT_SECONDS=15
BUSINESS_MD_PATH=data/business.md
ENVIRONMENT=development
